# FalkorDB (FalkorDB Cloud free tier or a local instance)
FALKORDB_HOST=
FALKORDB_PORT=
# Read-only user for agent queries (falls back to the admin user if empty)
FALKORDB_RO_USERNAME=
FALKORDB_RO_PASSWORD=
# Read-write user for ingestion, memory graphs and sync
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# GitHub token for ingestion and the daily sync (public read-only access is enough)
GITHUB_TOKEN=

# LLM for the agent (Groq) and embeddings (OpenAI text-embedding-3-small, 256 dims)
GROQ_API_KEY=
OPENAI_API_KEY=

# Cost guards
ASK_PER_IP_PER_HOUR=10
ASK_GLOBAL_PER_DAY=300
# Protects /api/cron/sync (Vercel sends it as a Bearer token)
CRON_SECRET=
